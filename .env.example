# Backend API base URL. Kong gateway on :8000 (ADR 0030) routes by service prefix.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Mock-first local dev (ADR 0014/0024). MUST be unset/false for any production build.
NEXT_PUBLIC_USE_MOCK=true

# Google OAuth client id (ADR 0035). Placeholder shows a graceful "SSO unavailable" state.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# Realtime SSE upstream (US-E06.2, re-architected US-E18.22/ADR 0065): the SSE
# proxy (`app/[locale]/api/stream/route.ts`) now routes through Kong via
# NEXT_PUBLIC_API_URL above (`/noti/api/v1/stream`) — same convention as every
# other feature. `NOTI_SERVICE_URL` (direct-service-bypass) is retired: it is
# structurally incompatible with edu-api ADR 0047 (notification trusts ONLY
# Kong-injected X-Edu-Claims) and unreachable under Docker network
# segmentation (notification has no published host port). Unset/mock mode →
# mock upstream serves dev frames.
